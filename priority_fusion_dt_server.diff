 // ===== In RunImpl(), add AFTER the initial priority queue is built
 // ===== (after the BlockingCounter parallel loop completes): =====

+    // --- dt_server: re-score initial queue with DT model ---
+    if (dt_strategy_ != nullptr &&
+        std::string(dt_strategy_) == "dt_server") {
+      DtScorerClient& client = GetDtScorerClient();
+      if (client.Connect()) {
+        // Extract all queued producers
+        std::vector<std::pair<Priority, HloInstruction*>> entries;
+        while (!producer_priority_queue_.IsEmpty()) {
+          auto top = producer_priority_queue_.Top();
+          entries.push_back(top);
+          producer_priority_queue_.Pop();
+        }
+
+        // Collect candidate names
+        std::vector<std::string> candidate_names;
+        candidate_names.reserve(entries.size());
+        for (const auto& [_, instr] : entries) {
+          candidate_names.push_back(std::string(instr->name()));
+        }
+
+        // Send INIT and get DT priorities
+        if (client.SendInit(candidate_names)) {
+          // Rebuild queue with DT priorities
+          for (const auto& [_, instr] : entries) {
+            int64_t dt_priority = client.GetPriority(
+                std::string(instr->name()));
+            if (dt_priority >= 0) {
+              producer_priority_queue_.Push(
+                  absl::Microseconds(dt_priority), instr);
+            } else {
+              // Fallback: keep original cost-model priority
+              producer_priority_queue_.Push(
+                  entries[0].first, instr);
+            }
+          }
+          LOG(INFO) << "DT dt_server: initial queue re-scored with "
+                    << candidate_names.size() << " producers";
+        } else {
+          // INIT failed: restore original queue
+          for (const auto& [priority, instr] : entries) {
+            producer_priority_queue_.Push(priority, instr);
+          }
+          LOG(WARNING) << "DT dt_server: INIT failed, using cost-model";
+        }
+      } else {
+        LOG(WARNING) << "DT dt_server: connection failed, using cost-model";
+      }
+    }

