+// ===== BEGIN Decision Transformer trajectory generation patch =====
+// Env vars:
+//   DT_FUSION_STRATEGY  - strategy name (omit for XLA default)
+//   DT_FUSION_SEED      - integer seed for random/perturbed
+//   DT_FUSION_SIGMA     - noise sigma for perturbed strategy (float)
+//   DT_FUSION_PLAN      - path to JSON ordering file (for json_plan)
+
+// Read env var once (thread-safe via static init).
+static const char* dt_strategy_ = std::getenv("DT_FUSION_STRATEGY");
+static const int64_t dt_seed_ = []() -> int64_t {
+  const char* s = std::getenv("DT_FUSION_SEED");
+  return s ? std::stoll(s) : 0;
+}();
+static const double dt_sigma_ = []() -> double {
+  const char* s = std::getenv("DT_FUSION_SIGMA");
+  return s ? std::stod(s) : 0.5;
+}();
+
+// Deterministic hash -> Gaussian via Box-Muller (seeded by name + seed).
+static double HashToGaussian(const std::string& name, int64_t seed) {
+  // FNV-1a 64-bit hash
+  uint64_t h = 14695981039346656037ULL;
+  for (char c : name) {
+    h ^= static_cast<uint64_t>(c);
+    h *= 1099511628211ULL;
+  }
+  // Mix in seed
+  h ^= static_cast<uint64_t>(seed) * 6364136223846793005ULL;
+  h *= 1099511628211ULL;
+
+  // Map to (0, 1) uniform
+  double u1 = (static_cast<double>(h & 0xFFFFFFFF) + 1.0) / 4294967298.0;
+
+  // Second hash for second uniform
+  uint64_t h2 = h;
+  h2 ^= h2 >> 33;
+  h2 *= 0xff51afd7ed558ccdULL;
+  h2 ^= h2 >> 33;
+  double u2 = (static_cast<double>(h2 & 0xFFFFFFFF) + 1.0) / 4294967298.0;
+
+  // Box-Muller
+  return std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * M_PI * u2);
+}
+
+// Load JSON plan file: {"producer_ordering": ["op1", "op2", ...]}
+// Returns map: producer_name -> position (0 = first = highest priority).
+using PlanOrdering = absl::flat_hash_map<std::string, int>;
+
+static PlanOrdering LoadJsonPlan(const char* path) {
+  PlanOrdering ordering;
+  if (!path) return ordering;
+
+  std::ifstream ifs(path);
+  if (!ifs.good()) {
+    LOG(WARNING) << "DT: Could not open plan file: " << path;
+    return ordering;
+  }
+
+  // Minimal JSON parser: find "producer_ordering" array of strings.
+  std::string content((std::istreambuf_iterator<char>(ifs)),
+                       std::istreambuf_iterator<char>());
+
+  size_t pos = content.find("\"producer_ordering\"");
+  if (pos == std::string::npos) {
+    LOG(WARNING) << "DT: No producer_ordering in plan file";
+    return ordering;
+  }
+  // Find opening bracket
+  pos = content.find('[', pos);
+  if (pos == std::string::npos) return ordering;
+
+  int index = 0;
+  size_t end = content.find(']', pos);
+  size_t search_pos = pos;
+  while (search_pos < end) {
+    size_t q1 = content.find('"', search_pos + 1);
+    if (q1 == std::string::npos || q1 >= end) break;
+    size_t q2 = content.find('"', q1 + 1);
+    if (q2 == std::string::npos || q2 >= end) break;
+    std::string name = content.substr(q1 + 1, q2 - q1 - 1);
+    ordering[name] = index++;
+    search_pos = q2;
+  }
+
+  LOG(INFO) << "DT: Loaded plan with " << ordering.size()
+            << " producers from " << path;
+  return ordering;
+}
+
+static const PlanOrdering& GetPlanOrdering() {
+  static const PlanOrdering ordering = LoadJsonPlan(
+      std::getenv("DT_FUSION_PLAN"));
+  return ordering;
+}
+// ===== END Decision Transformer trajectory generation patch =====
